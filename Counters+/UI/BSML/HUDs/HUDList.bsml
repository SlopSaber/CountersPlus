<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
  <!--Header-->
  <vertical child-control-height='false'>
    <horizontal bg='panel-top' pad-left='15' pad-right='15' horizontal-fit='PreferredSize'>
      <text text='HUD Canvases' align='Center' font-size='8'/>
    </horizontal>
  </vertical>

  <!--Canvas list-->
  <vertical anchor-min-x='0' anchor-max-x='1' anchor-min-y='0.17' anchor-max-y='0.85' size-delta-x='-5' size-delta-y='-2'
            vertical-fit='Unconstrained' horizontal-fit='Unconstrained' child-control-height='true' child-expand-height='true'>
    <list id='list' list-style='List' select-cell='cell-selected'/>
  </vertical>

  <!--Canvas actions-->
  <horizontal anchor-max-y='0.15' spacing='2' pad-left='3' pad-right='3'>
    <button text='New Canvas' on-click='new-canvas' vertical-fit='Unconstrained' horizontal-fit='Unconstrained'/>
    <button id='edit-button' text='Edit' on-click='edit-canvas' vertical-fit='Unconstrained' horizontal-fit='Unconstrained'/>
    <button id='delete-button' text='Delete' on-click='delete-canvas-prompt' vertical-fit='Unconstrained' horizontal-fit='Unconstrained'/>
  </horizontal>

  <modal-keyboard id='new-canvas-name' clear-on-open='true' on-enter='create-new-canvas' hide-event='on-deactivate'/>

  <modal id='delete-canvas' hide-event='on-deactivate' size-delta-x='65' size-delta-y='35'>
    <text text='Are you sure you want to delete this canvas?' align='Center'/>
    <horizontal anchor-max-y='0.2'>
      <button text='Yes' on-click='delete-selected-canvas' vertical-fit='Unconstrained' horizontal-fit='Unconstrained'/>
      <button text='No' on-click='cancel-deletion' vertical-fit='Unconstrained' horizontal-fit='Unconstrained'/>
    </horizontal>
  </modal>

  <modal id='canvas-error' hide-event='on-deactivate' size-delta-x='65' size-delta-y='35'>
    <text text='The Main canvas cannot be deleted.' align='Center'/>
    <horizontal anchor-max-y='0.2'>
      <button text='OK' on-click='cancel-deletion' vertical-fit='Unconstrained' horizontal-fit='Unconstrained'/>
    </horizontal>
  </modal>
</bg>
