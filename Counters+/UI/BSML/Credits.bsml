<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
  <vertical spacing='1' pad-top='1' child-control-height='true' child-expand-height='false' vertical-fit='Unconstrained'>

    <!--Compact credits-->
    <vertical bg='round-rect-panel' pref-width='100' pad='2' spacing='0.5' child-expand-height='false'>
      <horizontal spacing='3' child-expand-width='false' child-align='MiddleCenter'>
        <text id='creatorText' align='Center' font-size='3.5' text='Developed by Caeden117'/>
        <text id='versionText' align='Center' font-size='3' text='Version 0.0.0'/>
      </horizontal>
      <text id='aprilFoolsText' align='Center' font-size='3' text='April fools!'/>
      <text id='updateText' align='Center' font-size='2.5' text='Version 0.0.0 available for download!'/>
      <text id='linkOpenedText' align='Center' font-size='2.5' text='Link opened in your browser!'/>
      <horizontal spacing='1' child-expand-width='false' child-align='MiddleCenter'>
        <button id='github' text='GitHub' pref-width='30' pref-height='6'/>
        <button id='donate' text='Donate' pref-width='30' pref-height='6'/>
        <button id='issues' text='Report an Issue' pref-width='34' pref-height='6'/>
      </horizontal>
    </vertical>

    <!--Main settings-->
    <vertical id='main-settings' bg='round-rect-panel' pref-width='100' pad-left='3' pad-right='3' pad-top='1' pad-bottom='1' child-expand-height='false'/>
  </vertical>
</bg>
