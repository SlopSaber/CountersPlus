<!--Every Counter has these options-->
<vertical spacing='1' horizontal-fit='PreferredSize'>
	
  <!--Custom Counter multiplayer warning-->
  <vertical spacing='0.5' tags='multiplayer-warning'>
    <text align='Center' text='Warning!' color='#FF7F7F'/>
    <text align='Center' word-wrapping='true' pref-width='88' text='This custom counter is not marked as Multiplayer ready, and will not load in Multiplayer.'/>
  </vertical>

  <checkbox-setting text='Enabled' apply-on-change='true' value='Enabled' hover-hint='Toggle this counter on or off.' on-change='fire-update'/>
  <dropdown-list-setting text='Position' apply-on-change='true' value='Position' options='Positions' formatter='PositionsFormat' hover-hint='The relative position of common UI elements.' on-change='fire-update'/>
  <slider-setting text='Distance' min='-10' max='10' increment='0.01' show-buttons='true' apply-on-change='true' value='Distance' formatter='DistanceFormat' hover-hint='How far from the position the counter will be. A higher number means farther away.' on-change='fire-update'/>
  <dropdown-list-setting text='Canvas' apply-on-change='true' value='AttachedCanvas' options='AllCanvases' formatter='CanvasesFormat' hover-hint='The Canvas this counter is attached to.' on-change='fire-update'/>
</vertical>
